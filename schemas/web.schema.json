        },
        "referrer_policy": {
          "type": "string",
          "const": "no-referrer"
        },
        "no_ip_lookup_api": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "coordinates_only",
        "show_map",
        "map_service",
        "tile_origin",
        "renderer",
        "lazy_mount",
        "map_is_sole_geographic_visual",
        "attribution",
        "marker_precision",
        "disclose_approximate_coordinate",
        "anycast_suppresses_map",
        "no_postal_or_timezone_display",
        "external_network_exception",
        "referrer_policy",
