        },
        "animate_score_explanation": {
          "type": "boolean",
          "const": true
        },
        "avoid_continuous_idle_effects": {
          "type": "boolean",
          "const": true
        },
        "prefers_reduced_motion": {
          "type": "string",
          "const": "honor"
        }
