      "required": [
        "framework",
        "nuxt_module",
        "interaction_driven",
        "animate_hero",
        "animate_search_result_reveal",
        "animate_score_explanation",
        "avoid_continuous_idle_effects",
        "prefers_reduced_motion"
      ]
    },
    "3d": {
