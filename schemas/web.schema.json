{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vansail:contract:web:3:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "const": "VanSail IP Atlas"
        },
        "identifier": {
          "type": "string",
          "const": "vansail-ip-atlas"
        },
        "framework": {
          "type": "string",
          "const": "Nuxt 4"
        },
        "rendering": {
          "type": "string",
          "const": "static-generate"
        },
        "node_runtime": {
          "type": "string",
          "const": "none"
        },
        "api_runtime": {
          "type": "string",
          "const": "none"
        },
        "functions": {
          "type": "boolean",
          "const": false
        },
        "package_manager": {
          "type": "string",
          "const": "pnpm"
        },
        "command": {
          "type": "string",
          "const": "pnpm exec nuxt generate"
        },
        "output": {
          "type": "string",
          "const": "web/.output/public"
        },
        "data_origin": {
          "type": "string",
          "const": "same-origin"
        },
        "chromium_target": {
          "type": "string",
          "const": "current-stable-only"
        },
        "compatibility_fallbacks": {
          "type": "boolean",
          "const": false
        },
        "database_shards_bundled_into_pages": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "name",
        "identifier",
        "framework",
        "rendering",
        "node_runtime",
        "api_runtime",
        "functions",
        "package_manager",
        "command",
        "output",
        "data_origin",
        "chromium_target",
        "compatibility_fallbacks",
        "database_shards_bundled_into_pages"
      ]
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root_redirect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "const": "/"
            },
            "to": {
              "type": "string",
              "const": "/ip"
            },
            "code": {
              "type": "integer",
              "const": 302
            },
            "mechanism": {
              "type": "string",
              "const": "cloudflare-pages-_redirects"
            }
          },
          "required": [
            "from",
            "to",
            "code",
            "mechanism"
          ]
        },
        "landing": {
          "type": "string",
          "const": "/ip"
        },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "/ip": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "purpose": {
                  "type": "string",
                  "const": "centered-ip-asn-hero"
                },
                "owner_of": {
                  "type": "array",
                  "const": [
                    "search"
                  ]
                }
              },
              "required": [
                "purpose",
                "owner_of"
              ]
            },
            "/ip/overview": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "owner_of": {
                  "type": "array",
                  "const": [
                    "country",
                    "region",
                    "city",
                    "coordinates",
                    "usage_type",
                    "native_broadcast",
                    "anycast",
                    "isp"
                  ]
                }
              },
              "required": [
                "owner_of"
              ]
            },
            "/ip/quality": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "owner_of": {
                  "type": "array",
                  "const": [
                    "quality_state",
                    "quality_score",
                    "score_reasons",
                    "classification_reasons",
                    "layer_contributions"
                  ]
                }
              },
              "required": [
                "owner_of"
              ]
            },
            "/ip/class-c": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "owner_of": {
                  "type": "array",
                  "const": [
                    "ipv4_24_heatmap",
                    "neighborhood_context",
                    "256_ip_cells"
                  ]
                }
              },
              "required": [
                "owner_of"
              ]
            },
            "/ip/bgp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "owner_of": {
                  "type": "array",
                  "const": [
                    "as_path_graph",
                    "transit_peer_customer",
                    "tier1_candidates",
                    "rpki"
                  ]
                }
              },
              "required": [
                "owner_of"
              ]
            },
            "/ip/asn": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "owner_of": {
                  "type": "array",
                  "const": [
                    "asn_summary",
                    "asn_wide_risk",
                    "customer_cone",
                    "prefix_summary"
                  ]
                }
              },
              "required": [
                "owner_of"
              ]
            }
          },
          "required": [
            "/ip",
            "/ip/overview",
            "/ip/quality",
            "/ip/class-c",
            "/ip/bgp",
            "/ip/asn"
          ]
        },
        "reserved_paths": {
          "type": "array",
          "const": [
            "/latency",
            "/dns-leak",
            "/webrtc",
            "/cloudflare",
            "/split"
          ]
        },
        "query": {
          "type": "string",
          "const": "?q=<URL-encoded IP or ASN>"
        },
        "ip_submit_target": {
          "type": "string",
          "const": "/ip/overview?q=<canonical-IP>"
        },
        "asn_submit_target": {
          "type": "string",
          "const": "/ip/asn?q=AS<number>"
        },
        "asn_query_valid_routes": {
          "type": "array",
          "const": [
            "/ip/asn",
            "/ip/bgp"
          ]
        },
        "ip_only_routes": {
          "type": "array",
          "const": [
            "/ip/overview",
            "/ip/quality",
            "/ip/class-c"
          ]
        },
        "ip_query_asn_page": {
          "type": "string",
          "const": "show-all-origins"
        },
        "moas_bgp": {
          "type": "string",
          "const": "deterministic-origin-selector"
        },
        "ipv6_class_c": {
          "type": "string",
          "const": "not-applicable"
        },
        "missing_q": {
          "type": "string",
          "const": "redirect-/ip"
        },
        "invalid_q": {
          "type": "string",
          "const": "local-error-no-network"
        },
        "preserve_q_on_navigation": {
          "type": "boolean",
          "const": true
        },
        "no_duplicate_displays": {
          "type": "boolean",
          "const": true
        },
        "single_fact_owner": {
          "type": "boolean",
          "const": true
        },
        "no_source_or_credits_panel": {
          "type": "boolean",
          "const": true
        },
        "no_source_names_or_inspired_by_labels": {
          "type": "boolean",
          "const": true
        },
        "minimum_text": {
          "type": "boolean",
          "const": true
        },
        "icon_first": {
          "type": "boolean",
          "const": true
        },
        "mobile_first": {
          "type": "boolean",
          "const": true
        },
        "accessibility_reduced_motion": {
          "type": "boolean",
          "const": true
        },
        "asn_input_forms": {
          "type": "array",
          "const": [
            "AS13335",
            "13335"
          ]
        }
      },
      "required": [
        "root_redirect",
        "landing",
        "routes",
        "reserved_paths",
        "query",
        "ip_submit_target",
        "asn_submit_target",
        "asn_query_valid_routes",
        "ip_only_routes",
        "ip_query_asn_page",
        "moas_bgp",
        "ipv6_class_c",
        "missing_q",
        "invalid_q",
        "preserve_q_on_navigation",
        "no_duplicate_displays",
        "single_fact_owner",
        "no_source_or_credits_panel",
        "no_source_names_or_inspired_by_labels",
        "minimum_text",
        "icon_first",
        "mobile_first",
        "accessibility_reduced_motion",
        "asn_input_forms"
      ]
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component_system": {
          "type": "array",
