            "nuxt-ui",
            "shadcn-vue"
          ]
        },
        "component_selection": {
          "type": "string",
          "const": "nuxt-ui-first-no-duplicates"
        },
        "theme": {
          "type": "array",
          "const": [
            "light",
            "dark",
            "system"
          ]
        },
        "aesthetic": {
          "type": "string",
          "const": "liquid-glass-edge-lighting"
        },
        "edge_lighting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "const": true
            },
            "method": {
              "type": "string",
              "const": "conic-gradient-masked-border"
            },
            "thin_px": {
              "type": "integer",
              "const": 1
            },
            "focused_glow": {
              "type": "string",
              "const": "subtle"
            },
            "static_glow_when_idle": {
              "type": "boolean",
              "const": true
            },
            "only_animate_on_interaction": {
              "type": "boolean",
              "const": true
            },
            "min_contrast": {
              "type": "string",
              "const": "WCAG-AA"
            }
          },
          "required": [
            "enabled",
            "method",
            "thin_px",
            "focused_glow",
            "static_glow_when_idle",
            "only_animate_on_interaction",
            "min_contrast"
          ]
        },
        "blur_px_max": {
          "type": "integer",
          "const": 24
        },
        "translucent_surfaces": {
          "type": "boolean",
          "const": true
        },
        "avoid_glass_on_dense_graph_labels": {
          "type": "boolean",
          "const": true
        },
        "layout": {
          "type": "array",
          "const": [
            "large-negative-space",
            "low-density",
            "progressive-disclosure",
            "stacked-panels"
          ]
        },
        "transitions": {
          "type": "array",
          "const": [
            "subtle-spring",
            "opacity",
            "translate",
            "graph-path-highlight"
          ]
        },
        "theme_skins_separate_css_tokens": {
          "type": "boolean",
          "const": true
        },
        "do_not_show_source_attribution_in_ui": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "component_system",
        "component_selection",
        "theme",
        "aesthetic",
        "edge_lighting",
        "blur_px_max",
        "translucent_surfaces",
        "avoid_glass_on_dense_graph_labels",
        "layout",
        "transitions",
        "theme_skins_separate_css_tokens",
        "do_not_show_source_attribution_in_ui"
      ]
    },
    "motion": {
      "type": "object",
